GEMINI_API_KEY=replace-with-server-only-api-key
# Choose a structured-output model available to your account; see README.
GEMINI_MODEL=replace-with-model-id
FIREBASE_PROJECT_ID=replace-with-project-id
# Absolute path outside this repository, or omit to use host Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
CORS_ORIGINS=["http://localhost:5173"]
PROVIDER_TIMEOUT_SECONDS=25
USER_REQUEST_LIMIT=5
USER_WINDOW_SECONDS=60
CONNECTION_TEST_ENABLED=true
# TEMPORARY development-only settings (auth-resume: remove when Firebase sign-in resumes).
# DEV_AUTH_ENABLED skips Firebase token verification for local work; never set it in production.
# MOCK_PROVIDER_ENABLED swaps Gemini for a deterministic local stand-in; never set it in production.
DEV_AUTH_ENABLED=false
MOCK_PROVIDER_ENABLED=false
